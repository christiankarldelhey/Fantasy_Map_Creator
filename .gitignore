# Directories with large map files and GeoJSON data
Maps/
# Geojson/  # Commented to allow data/geojson/ to be tracked

# Ignore all data directory EXCEPT database/seeds/data/ (seed files must be committed for prod deploy)
# and backend/services/data/ + backend/domains/*/services/data/ (climate/moon/terrain source modules)
data/
!database/seeds/data/
!database/seeds/data/**
!backend/services/data/
!backend/services/data/**
!backend/domains/*/services/data/
!backend/domains/*/services/data/**

# Ignore scripts directory EXCEPT database/seeds/scripts/ (utility scripts for data import/migration, not needed to run app)
scripts/
!database/seeds/scripts/

# Ignore DEM rasters and data cache
data/*.tif
data/*.tiff
data/dem_elevation.tif

# Node modules
node_modules/

# System files
.DS_Store

# Environment variables
.env
.env.local

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
