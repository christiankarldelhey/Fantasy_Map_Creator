        Detector["Detector<br/><i>mind.detectors</i>"]
        Need["Need<br/><i>mind.needs</i>"]
        Thread["Thread<br/><i>mind.needs (open-loop kinds)</i>"]
        Mood["Mood<br/><i>mind.minds.mood (running) + mind.episodes.mood (the day's)</i>"]
        Temperament["Temperament<br/><i>mind.minds.temperament</i>"]
        Memory["Memory<br/><i>mind.memories</i>"]
        Conviction["Conviction<br/><i>mind.memories (facet conviction)</i>"]
        Forgotten["Forgotten<br/><i>mind.forgotten_memories</i>"]
        Past["Past<br/><i>mind.memories + mind.forgotten_memories (the kept, the lost, the patterns)</i>"]
        Belief["Belief<br/><i>mind.memories (conviction facet)</i>"]
        Relation["Relation<br/><i>mind.relations</i>"]
        Lens["Lens<br/><i>mind.episodes.brief + mind.episodes.lens_block</i>"]
        Focus["Focus<br/><i>mind.episodes.brief.focus</i>"]
        Musing["Musing<br/><i>mind.musings</i>"]
        Inner_language["Inner language<br/><i>mind.episodes.narrative (the channel, not a row)</i>"]
    end
    subgraph derived["Derived"]
        Novelty["Novelty<br/><i>derived per event: unseen tags ÷ tags (last 20 episodes)</i>"]
        Evocation["Evocation<br/><i>derived per open: memories the day connects to</i>"]
        Feeling["Feeling<br/><i>derived: live vector × pack mind.feeling_lexicon</i>"]
        Reflection["Reflection<br/><i>derived per close (LLM pass, trigger-gated)</i>"]
    end
    Thread -.->|is a| Need
    Conviction -.->|is a| Memory
    Forgotten -.->|is a| Memory
    Belief -.->|is a| Conviction
