        Mind_preset["Mind preset<br/><i>mind.mind_presets (+ preset_wiring / starter_beliefs / leans / musings / memories)</i>"]
        Decision["Decision<br/><i>mind.episodes.decisions</i>"]
        Perceived_day["Perceived day<br/><i>mind.episodes.perceived_day</i>"]
