%% Concepts — the glossary's vocabulary, grouped by home
flowchart TD
    subgraph wire["Wire"]
        Event["Event<br/><i>wire events[] → mind.episodes.events</i>"]
        Condition["Condition<br/><i>wire condition → mind.minds.body</i>"]
        Fate["Fate<br/><i>wire fate → mind.episodes.narrator_payload.fate</i>"]
        Tag["Tag<br/><i>events[].tags (wire); families fixed by the registry</i>"]
    end
    subgraph stored["Stored"]
        Mind["Mind<br/><i>mind.minds</i>"]
        Episode["Episode<br/><i>mind.episodes</i>"]
