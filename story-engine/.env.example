# Narrator Engine — Groq (required for /narrate-day LLM calls)
GROQ_API_KEY=
# Optional extra keys for fallback
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Mind Engine persistence. Everything this layer writes lives in the `mind`
# schema inside this database. The service keeps working without it (the
# narrator stays stateless); Mind endpoints degrade.
DATABASE_URL=postgresql+psycopg://localhost:5432/middle_earth
